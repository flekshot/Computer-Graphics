if(NOT DEFINED EXE OR NOT DEFINED SOURCE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "Pass EXE, SOURCE and TEST_ROOT")
endif()
set(relocated "${TEST_ROOT}/relocated test Жоба 星")
file(MAKE_DIRECTORY "${relocated}")
file(COPY_FILE "${EXE}" "${relocated}/SolarSystemExplorer.exe" ONLY_IF_DIFFERENT)
file(COPY "${SOURCE}/assets" "${SOURCE}/shaders" DESTINATION "${relocated}")
execute_process(COMMAND "${relocated}/SolarSystemExplorer.exe" --hidden --frames 3
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT output MATCHES "0 texture fallbacks")
    message(FATAL_ERROR "Unicode relocation failed: ${result}\n${output}\n${errors}")
endif()
file(WRITE "${relocated}/assets/textures/earth_daymap.jpg" "This is a corrupt texture, not a JPEG.")
execute_process(COMMAND "${relocated}/SolarSystemExplorer.exe" --hidden --frames 3
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT output MATCHES "1 texture fallbacks")
    message(FATAL_ERROR "Corrupt texture recovery failed: ${result}\n${output}\n${errors}")
endif()
file(WRITE "${relocated}/shaders/planet.frag" "#version 330 core\nintentionally invalid shader;\n")
execute_process(COMMAND "${relocated}/SolarSystemExplorer.exe" --hidden --frames 3
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(result EQUAL 0 OR NOT errors MATCHES "Shader compilation failed")
    message(FATAL_ERROR "Invalid shader was not reported properly: ${result}\n${output}\n${errors}")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/missing-shaders")
execute_process(COMMAND "${EXE}" --assets "${TEST_ROOT}/missing-shaders" --hidden --frames 3
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(result EQUAL 0 OR NOT errors MATCHES "Cannot open shader")
    message(FATAL_ERROR "Missing shader was not reported properly: ${result}\n${output}\n${errors}")
endif()
message(STATUS "Resource tests passed: Unicode relocation, corrupt texture fallback, invalid and missing shaders")
